@startuml
title Теплый дом. Экосистема C4 Components diagramm

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml
!theme crt-amber

Person(user, "Пользователь", "Пользователь системы Теплый дом. Экосистема")
System(FitLifeSystem, "Теплый дом. Экосистема", "")

Container_Boundary(FitLifeSystem, "Smart Home") {
    Container(WebApplication, "Web Application", "Java, Spring", "Веб-приложение"){
        Component(APIGateway, "APIGateway", "")
        Component(WebApp, "WebApp", "")
    }
    Container(Kafka, "Message broker", "Kafka", "Брокер сообщений")

    Container_Boundary(Users, "Users"){
        Container(UsersService, "Сервис управления пользователями", "егистрация, аутентификация, хранение связанных данных"){
            Component(UsersAPI, "Users API", "")
            Component(UsersManager, "Users manager")
        }
        Container(UsersDatabase, "Users Database", "PostgreSQL", "Хранение данных пользователей")
    }


    Container_Boundary(Heating, "Heating"){
        Container(HeatService, "Сервис управления отоплением", "Включение, выключение, контроль температуры"){
            Component(HeatingAPI, "HeatingAPI", "")
            Component(HeatingService, "Heating Service", "Business logic")
            Component(DeviceManager, "Device Manager", "Device state manager")
        }
        Container(HeatDatabase, "Heating Database", "PostgreSQL", "Хранения данных отопительных приборов")
    }

    Container_Boundary(Monitoring, "Monitoring"){
        Container(HeatMonitoring, "Сервис мониторинга температуры", "Мониторинг температуры"){
            Component(MonitoringAPI, "Monitoring API", "")
            Component(Sensor, "Sensor", "Heating data sensor")
        }
        Container(MonitoringDatabase, "Monitoring Database", "PostgreSQL", "Хранение данных температурных датчиков")
    }
    Container_Boundary(Video, "Video"){
        Container(VideoService, "Сервис видеонаблюдения", "Видеонаблюдение"){
            Component(VideoAPI, "Video API", "")
            Component(VideoHostService, "Video Host Service", "Video Host Schedule")
            Component(VideoManager, "Video devices manager", "Video devices manager")
        }
        Container(VideoDatabase, "Video Database", "PostgreSQL", "Хранение данных видеозаписей")
    }

    Container_Boundary(Gates, "Gates"){
        Container(GatesService, "Сервис управления воротами", "Открытие, закрытие ворот"){
            Component(GatesAPI, "Gates API", "")
            Component(GatesManager, "Gates manager", "Gates divice manager")
        }
        Container(GatesDatabase, "Gates Database", "PostgreSQL", "Хранение данных о воротах")
    }

    Container_Boundary(Light, "Light"){
        Container(LightService, "Сервис управления освещением", "Вкключение, выключение осветительных приборов"){
            Component(LightAPI, "Light API", "")
            Component(LIghtManager, "Light manager", "Light device manager")
        }
        Container(LightDatabase, "Light Database", "PostgreSQL", "Хранение данных освещения")
    }




}

Rel(user, WebApp, "Обращение к системе")
Rel(APIGateway, Kafka,"")
Rel(Kafka, APIGateway, "")
Rel(APIGateway, WebApp, "")
Rel(WebApp, APIGateway, "")

Rel(UsersAPI, APIGateway, "")
Rel(APIGateway, UsersAPI, "")

Rel(HeatingAPI, Kafka,"")

Rel(MonitoringAPI, Kafka,"")

Rel(Kafka,MonitoringDatabase,"")

Rel(GatesAPI, Kafka,"")

Rel(LightAPI, Kafka,"")

Rel(VideoAPI, Kafka,"")

@enduml